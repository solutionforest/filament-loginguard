{
    "name": "solution-forest/filament-loginguard",
    "description": "Brute force login protection for Filament, throttling and locking out malicious IPs and emails.",
    "keywords": [
        "SolutionForest",
        "laravel",
        "filamentphp",
        "filament",
        "filament-plugin",
        "filament-loginguard"
    ],
    "homepage": "https://github.com/solutionforest/filament-loginguard",
    "support": {
        "issues": "https://github.com/solutionforest/filament-loginguard/issues",
        "source": "https://github.com/solutionforest/filament-loginguard"
    },
    "license": "MIT",
    "authors": [
        {
            "name": "Solution Forest",
            "email": "info@solutionforest.net",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.3",
        "filament/filament": "^5.6.5",
        "spatie/laravel-package-tools": "^1.15.0",
        "whichbrowser/parser": "^2.1"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/breeze": "^2.4",
        "laravel/fortify": "^1.39",
        "laravel/pint": "^1.0",
        "nunomaduro/collision": "^8.0",
        "orchestra/testbench": "^9.0|^10.0|^11.0",
        "pestphp/pest": "^4.0",
        "pestphp/pest-plugin-arch": "^4.0",
        "pestphp/pest-plugin-laravel": "^4.0",
        "pestphp/pest-plugin-livewire": "^4.0",
        "rector/rector": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "SolutionForest\\FilamentLoginGuard\\": "src/",
            "SolutionForest\\FilamentLoginGuard\\Database\\Factories\\": "database/factories/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "SolutionForest\\FilamentLoginGuard\\Tests\\": "tests/",
            "Workbench\\App\\": "workbench/app/",
            "Workbench\\Database\\Factories\\": "workbench/database/factories/",
            "Workbench\\Database\\Seeders\\": "workbench/database/seeders/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "@clear",
            "@prepare",
            "@php ./vendor/bin/testbench package:discover --ansi"
        ],
        "analyse": "phpstan analyse",
        "lint": "pint",
        "refactor": "rector",
        "test": "pest",
        "test:lint": "pint --test",
        "test:refactor": "rector --dry-run",
        "clear": "@php vendor/bin/testbench package:purge-skeleton --ansi",
        "prepare": "@php vendor/bin/testbench package:discover --ansi",
        "build": [
            "@php vendor/bin/testbench workbench:build --ansi",
            "@php vendor/bin/testbench filament:assets --ansi"
        ],
        "serve": [
            "Composer\\Config::disableProcessTimeout",
            "@build",
            "@php vendor/bin/testbench serve --ansi"
        ],
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "npm run build:workbench",
            "@build",
            "@php vendor/bin/testbench serve --ansi"
        ]
    },
    "extra": {
        "laravel": {
            "providers": [
                "SolutionForest\\FilamentLoginGuard\\FilamentLoginGuardServiceProvider"
            ],
            "aliases": {
                "FilamentLoginGuard": "SolutionForest\\FilamentLoginGuard\\Facades\\FilamentLoginGuard"
            }
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "composer/package-versions-deprecated": true,
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
